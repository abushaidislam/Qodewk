# =============================================================================
# Qodewk — CLI & GitHub Action Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 OPTIONAL — App Base URL
# Override the web app URL used by CLI and web when generating receipt links.
# Set this to your custom domain or Vercel URL (e.g. https://my-domain.com)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# QODEWK_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# 🔗 OPTIONAL — API Endpoint Override
# Override the cloud API endpoint used by `qodewk share`.
# Default: {QODEWK_APP_URL}/api/receipts
# ─────────────────────────────────────────────────────────────────────────────
# QODEWK_API_URL=https://qodewk.flinkeo.online/api/receipts

# ─────────────────────────────────────────────────────────────────────────────
# 🔕 OPTIONAL — Telemetry Kill Switch
# Set to "off" to disable ALL cloud publishing.
# Receipts remain local-only in ~/.qodewk/state.db
# Git hooks and local SQLite still work normally.
# ─────────────────────────────────────────────────────────────────────────────
# QODEWK_TELEMETRY=off

# ─────────────────────────────────────────────────────────────────────────────
# 🧪 OPTIONAL — CI / No-DB Mode
# Set CI=true or QODEWK_NO_DB=true to force in-memory SQLite (no disk writes).
# Useful in GitHub Actions or read-only environments.
# ─────────────────────────────────────────────────────────────────────────────
# CI=true
# QODEWK_NO_DB=true

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 GitHub Action Only — GitHub Token
# Required only when using packages/action for sticky PR comments.
# In GitHub Actions, use: ${{ secrets.GITHUB_TOKEN }}
# ─────────────────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
