{
  "name": "@qodewk/core",
  "version": "0.9.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; ['dist', '.turbo'].forEach(d => fs.rmSync(d, { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@qodewk/pricing": "workspace:*",
    "@qodewk/protocol": "workspace:*",
    "simple-git": "^3.27.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
