# =============================================================================
# Qodewk — Web Application Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit secrets.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 REQUIRED — Canonical public URL of this deployment
# Used to generate receipt links and OG image URLs everywhere.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://qodewk.flinkeo.online

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️ OPTIONAL — Supabase Persistent Storage
# If not set, receipts are stored in-memory only (lost on server restart).
# Without Supabase, `qodewk share` links work but won't survive redeploys.
#
# Setup: https://supabase.com → New Project → Settings → API
# Then run the SQL from docs/10-mvp-48h.md (Hour 24-28) in the SQL editor.
# ─────────────────────────────────────────────────────────────────────────────
#
# Publishing receipts requires SUPABASE_SERVICE_ROLE_KEY: the anon key is read-only
# under the RLS policies in supabase/schema.sql.
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────────────────
# 🚦 RECOMMENDED — Upstash Redis rate limiting
# Shares the /api/receipts (30 req/min per IP) and docs chat limits across all
# serverless instances. Without it, /api/receipts falls back to a per-instance
# in-memory limiter, which does not hold across Vercel instances.
# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
